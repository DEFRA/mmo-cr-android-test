{
	"mcpServers": {
		"appium-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"appium-mcp@latest"
			],
			"tools": [
				"*"
			],
			"env": {
				"ANDROID_HOME": "/Users/randpate/Library/Android/sdk"
			}
		},
		"wdio-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@wdio/mcp"
			],
			"tools": [
				"*"
			]
		}
	}
}
