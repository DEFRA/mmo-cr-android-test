{
    "name": "mmo-cr-android-test",
    "version": "1.0.0",
    "private": true,
    "description": "WebdriverIO + Appium test automation for the Record Your Catch Android app (TypeScript)",
    "type": "module",
    "engines": {
        "node": ">=20.19.0"
    },
    "imports": {
        "#page-objects/*": "./test/page-objects/*.ts",
        "#components/*": "./test/components/*.ts"
    },
    "scripts": {
        "clean": "rm -rf allure-results && rm -rf allure-report",
        "test": "npm run clean && NODE_USE_ENV_PROXY=1 wdio run ./config/wdio.android.browserstack.conf.ts",
        "test:android": "wdio run ./config/wdio.android.conf.ts",
        "test:android:spec": "wdio run ./config/wdio.android.conf.ts --spec",
        "test:android:browserstack": "wdio run ./config/wdio.android.browserstack.conf.ts",
        "test:android:browserstack:spec": "wdio run ./config/wdio.android.browserstack.conf.ts --spec",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "report": "allure generate allure-results --clean",
        "report:publish": "npm run report; ./bin/publish-tests.sh",
        "generate:report": "allure generate allure-results --clean && allure open"
    },
    "author": "Defra DDTS",
    "license": "OGL-UK-3.0",
    "devDependencies": {
        "@types/node": "^26.6.3",
        "@wdio/allure-reporter": "^9.32.0",
        "@wdio/appium-service": "^9.32.0",
        "@wdio/browserstack-service": "^9.39.0",
        "@wdio/cli": "^9.32.0",
        "@wdio/globals": "^9.31.3",
        "@wdio/local-runner": "^9.32.0",
        "@wdio/mocha-framework": "^9.32.0",
        "@wdio/spec-reporter": "^9.32.0",
        "allure-commandline": "^2.46.1",
        "prettier": "^3.9.9",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "overrides": {
        "@grpc/grpc-js": "1.14.4",
        "serialize-javascript": "^7.0.7",
        "uuid": "11.1.1",
        "@puppeteer/browsers": "^3.2.0",
        "@xmldom/xmldom": "0.9.12",
        "js-yaml": "4.3.2"
    }
}
